@model ErrorViewModel
@{
    ViewData["Title"] = "Error en el sistema";
}

<section class="container section-space">
    <div class="alert alert-danger p-4 rounded shadow-sm">
        <h1 class="h3 fw-bold text-danger">Ha ocurrido un error inesperado</h1>
        <p class="text-muted">
            Lo sentimos, se ha producido un inconveniente al procesar tu solicitud en TechStore. El incidente ha sido registrado para su diagnóstico y resolución.
        </p>
        @if (Model.ShowRequestId)
        {
            <div class="mb-3">
                <small class="text-secondary">Identificador de seguimiento (Request ID):</small>
                <div><code>@Model.RequestId</code></div>
            </div>
        }
        <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">Volver al inicio</a>
    </div>
</section>
