<!DOCTYPE html>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechStore</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechStore.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    TechStore
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end" id="navbarSupportedContent">
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Productos">Productos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Categorias">Categorías</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Productos" asp-action="Index">Administrar</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="AcercaDe">Nosotros</a></li>
                        <li class="nav-item"><a class="btn btn-light btn-sm px-3 ms-lg-2" asp-controller="Home" asp-action="Contactenos">Contáctenos</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer-tech text-white">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-md">
                    <strong>TechStore</strong>
                    <span class="ms-md-3 text-white-50">Tecnología para todos.</span>
                </div>
                <div class="col-md-auto text-md-end text-white-50">&copy; 2026 TechStore</div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
