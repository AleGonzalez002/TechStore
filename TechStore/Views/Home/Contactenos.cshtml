@{
    ViewData["Title"] = "Contáctenos";
}

<section class="page-banner">
    <div class="container">
        <h1>Contáctenos</h1>
        <p>Escríbenos y responderemos lo antes posible.</p>
    </div>
</section>

<section class="container section-space">
    <div class="row g-5">
        <div class="col-lg-7">
            <form class="contact-form">
                <div class="row g-3">
                    <div class="col-md-6"><label for="nombre">Nombre completo</label><input id="nombre" class="form-control" type="text" placeholder="Tu nombre" required /></div>
                    <div class="col-md-6"><label for="correo">Correo electrónico</label><input id="correo" class="form-control" type="email" placeholder="correo@ejemplo.com" required /></div>
                    <div class="col-12"><label for="asunto">Asunto</label><input id="asunto" class="form-control" type="text" placeholder="¿Cómo podemos ayudarte?" required /></div>
                    <div class="col-12"><label for="mensaje">Mensaje</label><textarea id="mensaje" class="form-control" rows="5" placeholder="Cuéntanos lo que necesitas" required></textarea></div>
                    <div class="col-12"><button class="btn btn-primary px-4" type="submit">Enviar mensaje</button></div>
                </div>
            </form>
        </div>
        <aside class="col-lg-5">
            <div class="contact-info"><h2>Información de contacto</h2><p>Nos encanta ayudarte a elegir la mejor tecnología.</p><ul><li><strong>Dirección</strong>San Salvador, El Salvador</li><li><strong>Correo</strong>hola@techstore.com</li><li><strong>Teléfono</strong>+503 2200-2026</li></ul></div>
        </aside>
    </div>
</section>
