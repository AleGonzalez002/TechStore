@model IEnumerable<Producto>

@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-section">
    <div class="container">
        <div class="hero-content">
            <h1>Tecnología para tu día a día.</h1>
            <p class="hero-text">Encuentra productos para estudiar, trabajar y disfrutar.</p>

            <div class="d-flex flex-wrap gap-3">
                <a class="btn btn-light btn-lg" asp-action="Productos">Ver productos</a>
                <a class="btn btn-outline-light btn-lg" asp-action="Categorias">Ver categorías</a>
            </div>
        </div>
    </div>
</section>

<section class="container section-space">
    <div class="section-heading">
        <h2>Productos destacados</h2>
        <a asp-action="Productos" class="link-primary">Ver todos</a>
    </div>

    <div class="row g-4">
        @foreach (var producto in Model)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_ProductCard" model="producto" />
            </div>
        }
    </div>
</section>
