@{
    ViewData["Title"] = "Acerca de nosotros";
}

<section class="page-banner">
    <div class="container">
        <h1>Acerca de nosotros</h1>
        <p>En TechStore creemos que una buena idea merece las herramientas correctas.</p>
    </div>
</section>

<section class="container section-space">
    <article class="story">
        <div><h2>Nuestra historia</h2></div>
        <p>TechStore nació con la idea de facilitar el acceso a productos tecnológicos útiles, modernos y confiables. Seleccionamos cada producto pensando en estudiantes, creadores, profesionales y amantes de la innovación.</p>
    </article>

    <div class="row g-4 mt-1">
        <div class="col-md-6"><article class="value-card"><h2>Misión</h2><p>Acercar tecnología de calidad que ayude a las personas a aprender, crear y avanzar.</p></article></div>
        <div class="col-md-6"><article class="value-card"><h2>Visión</h2><p>Ser una tienda tecnológica reconocida por su cercanía, confianza e innovación.</p></article></div>
    </div>

    <section class="values mt-5">
        <h2>Valores</h2>
        <div class="row g-3 mt-1">
            <div class="col-sm-4"><strong>Confianza</strong><p>Recomendamos con honestidad.</p></div>
            <div class="col-sm-4"><strong>Innovación</strong><p>Nos mueve descubrir lo nuevo.</p></div>
            <div class="col-sm-4"><strong>Cercanía</strong><p>Escuchamos antes de responder.</p></div>
        </div>
    </section>
</section>
