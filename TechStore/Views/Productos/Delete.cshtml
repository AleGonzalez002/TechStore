@model Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<section class="container section-space">
    <h1>Eliminar Producto</h1>
    <p>¿Está seguro de que desea eliminar el siguiente producto?</p>

    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>

        <dt class="col-sm-2">Categoría</dt>
        <dd class="col-sm-10">@Model.Categoria?.Nombre</dd>

        <dt class="col-sm-2">Precio</dt>
        <dd class="col-sm-10">$@Model.Precio.ToString("N2")</dd>

        <dt class="col-sm-2">Stock</dt>
        <dd class="col-sm-10">@Model.Stock</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</section>
